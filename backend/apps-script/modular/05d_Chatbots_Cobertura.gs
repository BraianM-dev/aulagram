/** Cobertura ampliada v8.7: garantiza respuesta para todos los temas que los bots ofrecen. */
function botExpandedKnowledge_(bot,q){
  if(hasAny_(q,['formulario','form','input','label']))return 'Un formulario HTML reúne controles para ingresar datos. <label> describe un control y debería asociarse a su input. En una web real, los datos recién se procesan cuando JavaScript o un servidor reciben el envío.';
  if(hasAny_(q,['class','id html','clase html']))return 'class permite agrupar varios elementos para aplicar estilos o seleccionarlos; id identifica un elemento de forma única dentro de la página. En CSS, .clase selecciona class y #id selecciona id.';
  if(hasAny_(q,['meta viewport','viewport']))return '<meta name="viewport" content="width=device-width, initial-scale=1.0"> ayuda a que la página use correctamente el ancho del dispositivo móvil.';
  if(hasAny_(q,['lang es','idioma html']))return 'El atributo lang del elemento <html> indica el idioma principal del documento. Por ejemplo <html lang="es"> ayuda a navegadores y tecnologías de apoyo.';
  if(hasAny_(q,['selector','selectores css']))return 'Un selector CSS indica a qué elementos se aplica una regla. Ejemplos: p selecciona etiquetas, .tarjeta selecciona una clase y #principal un id.';
  if(hasAny_(q,['color css','colores css','paleta']))return 'CSS acepta colores con nombres, hexadecimal, rgb(), hsl() y otras sintaxis. Elegí una paleta con contraste suficiente y no uses solamente color para comunicar información importante.';
  if(hasAny_(q,['tipografia','font-family','font-size']))return 'font-family elige la familia tipográfica y font-size el tamaño. Conviene priorizar legibilidad, tamaños escalables y una jerarquía clara entre títulos y texto.';
  if(hasAny_(q,['position','absolute','relative','fixed','sticky']))return 'position controla cómo se posiciona un elemento. relative conserva su lugar y sirve de referencia; absolute sale del flujo normal respecto de un ancestro posicionado; fixed se fija a la ventana; sticky combina flujo y fijación según el scroll.';
  if(hasAny_(q,['overflow']))return 'overflow controla qué ocurre cuando el contenido supera su caja. hidden recorta, auto agrega desplazamiento cuando hace falta y visible deja desbordar.';
  if(hasAny_(q,['transition','animacion css','animation']))return 'transition suaviza un cambio entre estados; animation usa @keyframes para secuencias más complejas. Las animaciones no esenciales deberían respetar prefers-reduced-motion.';
  if(hasAny_(q,['tipo de dato','tipos de datos','string','boolean','number']))return 'En JavaScript hay tipos como string, number, boolean, null, undefined, bigint y symbol; arrays y objetos organizan colecciones y estructuras. typeof ayuda a inspeccionar varios tipos.';
  if(hasAny_(q,['condicional javascript','if javascript','else javascript']))return 'En JavaScript, if ejecuta un bloque si una condición es verdadera; else if prueba otra condición y else cubre el resto. Usá === para comparaciones estrictas cuando sea posible.';
  if(hasAny_(q,['bucle javascript','for javascript','while javascript']))return 'JavaScript tiene bucles como for, while y for...of. Elegí el que haga más clara la intención y cuidá que un while tenga una condición que pueda terminar.';
  if(hasAny_(q,['operadores javascript','===','==']))return '=== compara valor y tipo; == permite conversiones automáticas y puede dar resultados inesperados. Para empezar suele ser más seguro usar === y !==.';
  if(hasAny_(q,['async','await','promise','promesa']))return 'Una Promise representa un resultado que llegará en el futuro. async/await permite escribir código asíncrono de forma más legible, por ejemplo al esperar un fetch.';
  if(hasAny_(q,['random python','aleatorio python']))return 'El módulo random permite generar valores pseudoaleatorios. Por ejemplo random.randint(1,6) simula un dado. Primero se importa con import random.';
  if(hasAny_(q,['tipo de dato python','str','int','float','bool']))return 'Python usa tipos como str para texto, int para enteros, float para decimales y bool para verdadero/falso. type(valor) permite inspeccionar el tipo.';
  if(hasAny_(q,['comparadores python','==','!=','>=','<=']))return 'En Python, == compara igualdad, != diferencia, > y < orden, y >= / <= incluyen igualdad. Una condición produce True o False.';
  if(hasAny_(q,['entrenamiento ia','entrenar modelo']))return 'Entrenar un modelo consiste en ajustar parámetros usando datos y un objetivo. La calidad depende de datos, diseño, evaluación y contexto; más datos no garantiza automáticamente mejores resultados.';
  if(hasAny_(q,['privacidad ia','datos ia']))return 'Antes de enviar información a una herramienta de IA conviene revisar qué datos se comparten, para qué se usan y si contienen información personal o institucional sensible.';
  if(hasAny_(q,['accesibilidad','web accesible']))return 'Accesibilidad web busca que más personas puedan percibir, comprender y operar una interfaz, incluyendo quienes usan teclado, lectores de pantalla, ampliación, alto contraste o reducción de movimiento.';
  if(hasAny_(q,['movimiento reducido','reducir movimiento']))return 'Reducir movimiento evita animaciones o desplazamientos innecesarios para quienes lo prefieren. En CSS se puede consultar prefers-reduced-motion.';
  if(hasAny_(q,['redes','red informatica','network']))return 'Una red informática conecta dispositivos para intercambiar datos y compartir servicios. Podemos estudiar LAN, IP, DNS, DHCP, routers, switches, Wi‑Fi, HTTP y cliente/servidor.';
  if(hasAny_(q,['internet']))return 'Internet es una red de redes que usa protocolos comunes, especialmente la familia TCP/IP. Una LAN puede existir sin Internet, pero para llegar a servicios externos necesita conectividad hacia otras redes.';
  if(hasAny_(q,['wifi','wi-fi']))return 'Wi‑Fi permite conectar dispositivos a una red local mediante radio. Wi‑Fi no significa Internet: podés estar conectado al punto de acceso aunque la red no tenga salida a Internet.';
  if(hasAny_(q,['paquete','packet']))return 'Los datos de red se dividen en unidades que viajan por distintos equipos. Según la capa hablamos de tramas, paquetes o segmentos; cada una agrega información de control.';
  if(hasAny_(q,['mac','direccion mac']))return 'Una dirección MAC identifica una interfaz en tecnologías de enlace como Ethernet o Wi‑Fi. No cumple el mismo papel que una IP, que sirve para direccionamiento lógico entre redes.';
  if(hasAny_(q,['url']))return 'Una URL indica dónde está un recurso y cómo acceder a él. Puede incluir esquema como https, nombre de host, puerto, ruta, parámetros y fragmento.';
  if(hasAny_(q,['archivo','archivos','carpeta','directorio']))return 'Un archivo guarda información con un nombre; una carpeta o directorio organiza archivos y otras carpetas. En proyectos web, mantener rutas claras evita imágenes o CSS rotos.';
  if(hasAny_(q,['extension de archivo','extension']))return 'La extensión, como .html, .css, .js o .png, orienta sobre el tipo de archivo, aunque el contenido real y su tipo MIME también importan.';
  if(hasAny_(q,['mime','tipo mime']))return 'Un tipo MIME describe el tipo de contenido, por ejemplo text/html, text/css, application/json o image/png. Los navegadores lo usan para interpretar respuestas.';
  if(hasAny_(q,['json','objeto json']))return 'JSON es un formato de texto para representar datos estructurados con objetos, arrays, números, strings, booleanos y null. Las claves de objetos JSON deben ir entre comillas dobles.';
  if(hasAny_(q,['datos','dato','estructura de datos']))return 'Los datos son representaciones de hechos o valores que un programa puede guardar, procesar y transmitir. Elegir una estructura adecuada facilita buscar, actualizar y comprender la información.';
  if(hasAny_(q,['commit']))return 'Un commit en Git registra un conjunto de cambios con un identificador y un mensaje. Conviene que cada commit represente una modificación coherente y tenga un mensaje claro.';
  if(hasAny_(q,['branch','rama git']))return 'Una rama permite desarrollar cambios sin alterar inmediatamente la rama principal. Después se puede comparar, revisar y fusionar.';
  if(hasAny_(q,['pull request','pr github']))return 'Un Pull Request propone integrar cambios de una rama y permite revisar diferencias, comentar y comprobar antes de fusionar.';
  if(hasAny_(q,['git','github']))return 'Git controla versiones de archivos y GitHub aloja repositorios Git con herramientas de colaboración. Puedo explicarte commits, ramas, pull requests, Pages y conflictos.';
  if(hasAny_(q,['hardware']))return 'Hardware son los componentes físicos de un sistema: CPU, RAM, almacenamiento, placa madre, red, periféricos y más. El software usa ese hardware mediante el sistema operativo y controladores.';
  if(hasAny_(q,['placa madre','motherboard']))return 'La placa madre conecta CPU, memoria, almacenamiento, buses y periféricos. También integra firmware y controladores que permiten iniciar el equipo.';
  if(hasAny_(q,['microbit','micro:bit']))return 'micro:bit es una placa educativa con microcontrolador, botones, matriz LED, sensores y pines. Puede programarse con MakeCode por bloques o con otros lenguajes según el entorno.';
  if(hasAny_(q,['esp32']))return 'ESP32 es una familia de microcontroladores con conectividad, muy usada en proyectos IoT. Puede trabajar con Wi‑Fi/Bluetooth según el modelo y programarse con distintos entornos.';
  if(hasAny_(q,['seguridad','ciberseguridad']))return 'Ciberseguridad busca proteger sistemas, cuentas y datos. Algunas bases son actualizar, usar contraseñas únicas, 2FA, copias de seguridad, revisar enlaces y aplicar mínimos privilegios.';
  if(hasAny_(q,['firewall']))return 'Un firewall controla tráfico de red según reglas. Puede permitir o bloquear conexiones por dirección, puerto, protocolo u otros criterios.';
  if(hasAny_(q,['vpn']))return 'Una VPN crea un túnel protegido entre un dispositivo y otro punto de red. Puede mejorar privacidad en tránsito o permitir acceso remoto, pero no vuelve anónimo todo lo que hacés.';
  if(hasAny_(q,['tls','ssl']))return 'TLS protege comunicaciones en tránsito mediante cifrado e identidad del servidor. HTTPS usa HTTP sobre TLS. “SSL” suele usarse de forma histórica para referirse a esta familia de tecnologías.';
  if(hasAny_(q,['ciudadania digital','ciudadanía digital']))return 'Ciudadanía digital implica participar de forma responsable, crítica y respetuosa: cuidar privacidad, verificar información, respetar licencias, convivir sin acoso y comprender la huella que dejamos.';
  if(hasAny_(q,['privacidad']))return 'Privacidad implica decidir qué datos compartimos, con quién y para qué. En AulaGram conviene usar alias y evitar nombre completo, dirección, teléfono, contraseñas u otros datos sensibles.';
  if(hasAny_(q,['html']))return 'HTML es el lenguaje de marcado que estructura una página. Puedo ayudarte con etiquetas, semántica, atributos, imágenes, alt, enlaces, listas, formularios y rutas.';
  if(hasAny_(q,['css']))return 'CSS controla la presentación visual. Puedo ayudarte con selectores, cascada, caja, colores, tipografía, Flexbox, Grid, responsive, hover y animaciones.';
  if(hasAny_(q,['javascript',' js ']))return 'JavaScript agrega lógica e interacción. Puedo ayudarte con variables, tipos, condicionales, bucles, funciones, arrays, DOM, eventos, JSON, localStorage, fetch y asincronía.';
  if(hasAny_(q,['python']))return 'Python es un lenguaje general. Puedo ayudarte con variables, input/print, tipos, condicionales, while, for, listas, diccionarios, funciones, random y depuración.';
  if(hasAny_(q,['ia','inteligencia artificial']))return 'En IA puedo trabajar machine learning, IA generativa, LLM, prompts, tokens, embeddings, RAG, sesgos, alucinaciones, deepfakes, privacidad y verificación.';
  if(hasAny_(q,['wcag']))return 'WCAG reúne pautas para que la web sea perceptible, operable, comprensible y robusta. Puedo ayudarte con contraste, teclado, foco, alt, reflow, ARIA y movimiento reducido.';
  if(hasAny_(q,['lan']))return 'Una LAN es una red de alcance local. Puedo relacionarla con IP, DNS, DHCP, router, switch, Wi‑Fi, HTTP y cliente/servidor.';
  return null;
}
